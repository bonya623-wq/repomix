# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz

# Channel username (with @) or numeric ID (e.g. -1001234567890)
CHANNEL_ID=@your_channel_name

# How often to check for new articles, in seconds (default: 300 = 5 min)
CHECK_INTERVAL=300

# Max articles to publish per check cycle (prevents flooding)
MAX_ARTICLES_PER_RUN=5

# Path to JSON database of published article URLs
DB_PATH=published.json

# HTTP request timeout in seconds
REQUEST_TIMEOUT=15
